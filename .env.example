# -----------------------------------------------------------------------------
# Pick n Go environment variables
# Copy to .env.local and fill in. Never commit real values.
# -----------------------------------------------------------------------------

# Public base URL of the site, used for canonical URLs, sitemap and Open Graph.
# Vercel previews fall back to VERCEL_URL automatically when this is unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Dashboard -> Project Settings -> API Keys).
# When these are missing the public site renders clearly labeled sample content.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY. Secret key (sb_secret_...) or legacy service_role key.
# Used exclusively by server code (public submissions endpoint).
# Never prefix with NEXT_PUBLIC_ and never import it in client components.
SUPABASE_SECRET_KEY=
